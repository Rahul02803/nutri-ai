# Supabase Configuration (Optional - Enabled if provided, else falls back to premium mock simulator)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Engine Credentials (Provide at least one to enable live AI coaching, otherwise runs with simulation prompt responses)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Configuration (Required for Live Google Auth & Cloud Firestore Sync)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_WEB_CLIENT_ID=your_project_web_oauth_client_id.apps.googleusercontent.com
